# Optional: only necessary for AI-written itinerary explanations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional for frontend in case API is bound elsewhere:
API_URL=http://127.0.0.1:8000
# Optional: comma-separated browser origins allowed by FastAPI CORS
CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860
# Public Nominatim needs identifying User-Agent (set a real contact for public deployments)
OSM_USER_AGENT=TravelMateMVP/1.0 (educational-demo; contact: github.com)
# Turn off public OSRM requests for driving (then use the heuristic)
ALLOW_OSRM=1
